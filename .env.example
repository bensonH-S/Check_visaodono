# Copie para .env na raiz OU mantenha em backend/.env (o server.js carrega os dois)
DB_HOST=localhost
DB_USER=postgres
# Senha do PostgreSQL (obrigatória se o servidor usa autenticação SCRAM)
DB_PASS=
DB_NAME=vision_check
DB_PORT=5432
DB_SSL=false
PORT=5000

# Chave AES-256 para criptografar imagens/vídeos no banco (openssl rand -hex 32)
MEDIA_ENCRYPTION_KEY=089f2668a98d386f2ae120a57e2105d41ee288f96b63335ad91c2d8cfd9e2fad

# Rodapé: versão vem da tag Git no build (git tag v1.1.0 && npm run build)
# APP_ENV=Production
SUPPORT_NAME=Benson Henrique
SUPPORT_PHONE=+55 61 9109-4654
SUPPORT_EMAIL=benson.henrique@grupoalvim.com.br

# Web Push (PWA — notificações com app fechado). Gere com: npm run generate:vapid
VAPID_PUBLIC_KEY=BEocPR2BZeAXkLSTJZcNPqADU2LtI5gMK1OVEBr6tIDsXyV8UmDY4Kp1mfdkqNesY2e6-e447JE_0EMbhpR-NLw
VAPID_PRIVATE_KEY=GWQ1PBI-SrNc2DxnD1u9WtwLuLAycZDBv1B6G2dEdUk
VAPID_SUBJECT=mailto:benson.henrique@grupoalvim.com.br

# Logs diários em Check_visaodono/Logs/YYYY-MM-DD.log (sempre dentro do projeto)
# LOG_DIR=Logs
# LOG_DEBUG=1

# =============================================================================
# WhatsApp — wppconnect-server (docker-compose: serviço wppconnect)
# =============================================================================
# Ativar envio de mensagens WhatsApp nos eventos de chamado
WPP_ENABLED=false

# Host da API wppconnect:
#   Produção Docker (rede interna):  http://wppconnect
#   Local / wpp na mesma máquina:      http://localhost
WPP_HOST=http://wppconnect
WPP_PORT=21465

# Chave compartilhada com o container wppconnect (mesmo valor no .env dos dois serviços)
# Gere com: openssl rand -hex 32
WPP_SECRET_KEY=THISISMYSECURETOKEN

# Nome da sessão WhatsApp (uma sessão por instalação)
WPP_SESSION=wpp_visao_check

# Token Bearer fixo (opcional). Se vazio, é gerado na 1ª conexão e salvo no banco (wpp_sessao).
# WPP_TOKEN=

# --- Após subir o Docker ---
# 1. WPP_ENABLED=true
# 2. WPP_SECRET_KEY igual no app e no wppconnect
# 3. Portal → Configurações → WhatsApp → escanear QR Code
# 4. Usuários: preencher telefone_whatsapp em Configurações → Usuários

# URL pública do app (links no WhatsApp). Com /auditoria — sem barra no final.
PUBLIC_APP_URL=https://grupoalvim.com.br/auditoria
