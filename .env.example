# =============================================================================
# Meridian — modelo de variáveis (.env)
# Copie para a RAIZ do projeto como `.env` (deploy Docker usa esse arquivo).
# Localmente o `server.js` também lê `backend/.env` (ele prevalece).
# =============================================================================
#
# NÃO commitar `.env` com senhas reais.
# Bloco pronto para o VPS (BK Office): veja no final → "COPIAR PARA O VPS"
#

# -----------------------------------------------------------------------------
# 1) CORE — banco e API
# -----------------------------------------------------------------------------
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=vision_check
DB_PORT=5432
# Produção Docker: 3007 | Dev local API: 5000
PORT=3007

# -----------------------------------------------------------------------------
# 2) AUTH / MÍDIA
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=7d
MEDIA_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# 3) SUPORTE (rodapé / contato)
# -----------------------------------------------------------------------------
SUPPORT_NAME=
SUPPORT_PHONE=
SUPPORT_EMAIL=

# -----------------------------------------------------------------------------
# 4) WEB PUSH (PWA)
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@example.com

# -----------------------------------------------------------------------------
# 5) WHATSAPP (wppconnect)
# -----------------------------------------------------------------------------
WPP_ENABLED=false
# Docker: http://wppconnect | Local: http://localhost
WPP_HOST=http://wppconnect
WPP_PORT=21465
WPP_SECRET_KEY=
WPP_SESSION=wpp_visao_check
PUBLIC_APP_URL=https://grupoalvim.com.br/auditoria

# -----------------------------------------------------------------------------
# 6) E-MAIL (relatório de visita)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=MERIDIAN <noreply@example.com>
# MAIL_REPLY_TO=
# VISITA_RELATORIO_EMAIL_ENABLED=true

# -----------------------------------------------------------------------------
# 7) IA
# -----------------------------------------------------------------------------
# AI_ENABLED=true
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# 8) FULLTRACK (frota)
# -----------------------------------------------------------------------------
FULLTRACK_RASTREAMENTO_ENABLED=true
FULLTRACK_API_KEY=
FULLTRACK_SECRET_KEY=
FULLTRACK_API_URL=http://ws.fulltrack2.com
FULLTRACK_LIMITE_VELOCIDADE_KMH=80
# OPENROUTESERVICE_API_KEY=

# -----------------------------------------------------------------------------
# 9) FREECONTROL (opcional)
# -----------------------------------------------------------------------------
# FREECONTROL_API_URL=http://127.0.0.1:5001
# FREECONTROL_APPROVAL_TOKEN=

# -----------------------------------------------------------------------------
# 10) ESTOQUE — Platlog / eSupri / Brasal (NF-e)
# -----------------------------------------------------------------------------
# ESUPRI_USER=
# ESUPRI_PASS=
# ESUPRI_BASE_URL=https://www.esupri.com.br
# ESUPRI_USE_CHROME=0
# BRASAL_USER=
# BRASAL_PASS=
# BRASAL_BASE_URL=https://conectabrasal.com.br/

# =============================================================================
# 11) BK OFFICE — PRODUÇÃO (VPS + Bright Data)
#     >>> ESTE BLOCO É O QUE VOCÊ PRECISA NO SERVIDOR <<<
# =============================================================================
BKOFFICE_USER=
BKOFFICE_PASS=
BKOFFICE_URL=https://bkoffice-franquia.burgerking.com.br
BKOFFICE_HEADLESS=1
BKOFFICE_USE_CHROME=0
BKOFFICE_TIMEOUT_MS=60000
BKOFFICE_SYNC_RETRIES=3
BKOFFICE_SYNC_ID_LOJAS=all
BKOFFICE_SERVER_SYNC=1
BKOFFICE_SYNC_CRON_MS=600000

BKOFFICE_BRIGHTDATA=1
BRIGHTDATA_PROXY_SERVER=http://brd.superproxy.io:44445
BRIGHTDATA_PROXY_USER=brd-customer-hl_c5f6474c-zone-bkoffice_br-country-br
BRIGHTDATA_PROXY_PASSWORD=

# Kit PC gerência = LEGADO (ficar 0)
BKOFFICE_KIT_ENABLED=0
# BKOFFICE_KIT_TOKEN=

# =============================================================================
# FIM
# =============================================================================
