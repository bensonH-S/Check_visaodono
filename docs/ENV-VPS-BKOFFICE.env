# =============================================================================
# COPIAR / MESCLAR NO .env DO VPS (produção)
# Arquivo: raiz do projeto no servidor (mesmo .env do docker-compose)
# =============================================================================
# Depois: rodar migration 158 + restart do container
# Teste: node backend/scripts/sync-bkoffice-vendas.mjs --loja=12 --db=prod --dias=0
# =============================================================================

# --- Sync no servidor (substitui o kit PC) ---
BKOFFICE_SERVER_SYNC=1
BKOFFICE_SYNC_CRON_MS=600000
BKOFFICE_SYNC_ID_LOJAS=all
BKOFFICE_SYNC_RETRIES=3
BKOFFICE_KIT_ENABLED=0

# --- Login BK Office ---
BKOFFICE_USER=RENATO.FROTA
BKOFFICE_PASS=
BKOFFICE_URL=https://bkoffice-franquia.burgerking.com.br
BKOFFICE_HEADLESS=1
BKOFFICE_USE_CHROME=0
BKOFFICE_TIMEOUT_MS=60000

# --- Bright Data (IP Brasil) — senha só aqui, nunca no código ---
BKOFFICE_BRIGHTDATA=1
BRIGHTDATA_PROXY_SERVER=http://brd.superproxy.io:44445
BRIGHTDATA_PROXY_USER=brd-customer-hl_c5f6474c-zone-bkoffice_br-country-br
BRIGHTDATA_PROXY_PASSWORD=

# Remova ou comente no VPS (legado kit):
# BKOFFICE_SYNC_CRON_MS=0
# BKOFFICE_SERVER_SYNC=0
# BKOFFICE_USE_CHROME=1
# BKOFFICE_KIT_TOKEN=...
