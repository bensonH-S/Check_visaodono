# =============================================================================
# COPIAR / MESCLAR NO .env DO VPS (produção) — bloco BK Office v2.0.3+
# Arquivo: raiz do projeto no servidor (mesmo .env do docker-compose)
# =============================================================================
# Deploy tag v2.0.3 → preencher BKOFFICE_PASS + BKOFFICE_KIT_TOKEN → recreate
# =============================================================================

# --- Login BK Office ---
BKOFFICE_USER=RENATO.FROTA
BKOFFICE_PASS=
BKOFFICE_URL=https://bkoffice-franquia.burgerking.com.br
BKOFFICE_HEADLESS=1
BKOFFICE_USE_CHROME=0
BKOFFICE_TIMEOUT_MS=60000
BKOFFICE_SYNC_RETRIES=3
BKOFFICE_SYNC_ID_LOJAS=all

# --- Kit PC gerência (rota principal) ---
BKOFFICE_KIT_ENABLED=1
# openssl rand -hex 32  (igual no backend/.env da máquina que gera o kit)
BKOFFICE_KIT_TOKEN=
API_BASE=https://grupoalvim.com.br/auditoria/api

# --- Scheduler VPS off (kit coleta; VPS só recebe) ---
BKOFFICE_SERVER_SYNC=0
BKOFFICE_SYNC_CRON_MS=0

# --- Bright Data (fallback; Akamai pode bloquear) ---
BKOFFICE_BRIGHTDATA=0
# BRIGHTDATA_PROXY_SERVER=http://brd.superproxy.io:44445
# BRIGHTDATA_PROXY_USER=brd-customer-hl_c5f6474c-zone-bkoffice_br-country-br
# BRIGHTDATA_PROXY_PASSWORD=
