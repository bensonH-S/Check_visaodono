# Exemplo: Vision Check em https://grupoalvim.com.br/auditoria/
# Container Docker / deploy.sh escuta na porta 3007 (PORT no .env)
# Copie para sites-available e ajuste caminhos/portas.

upstream vision_check_app {
    server 127.0.0.1:3007;
}

server {
    listen 443 ssl http2;
    server_name grupoalvim.com.br;

    # ssl_certificate ...;
    # ssl_certificate_key ...;

    # CIGA — painel gestores (HTML estático via Node)
    location = /ciga {
        return 302 /ciga/;
    }

    location /ciga/ {
        proxy_pass http://vision_check_app/ciga/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Redireciona /auditoria (sem barra) para o login
    location = /auditoria {
        return 302 /auditoria/login;
    }

    # API Node (prefixo /auditoria/api)
    location /auditoria/api/ {
        proxy_pass http://vision_check_app/auditoria/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Opção A — Node serve o build (produção: node server.js --production)
    location /auditoria/ {
        proxy_pass http://vision_check_app/auditoria/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Opção B — Nginx serve arquivos estáticos (comente bloco acima)
    # location /auditoria/ {
    #     alias /var/www/vision-check/frontend/dist/;
    #     try_files $uri $uri/ /auditoria/index.html;
    # }
}
