{
  "name": "vision-check",
  "private": true,
  "scripts": {
    "predev": "npx --yes kill-port 5000",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --prefix backend",
    "dev:web": "npm run dev --prefix frontend",
    "migrate": "npm run migrate --prefix backend",
    "migrate:lojas": "npm run migrate:lojas --prefix backend",
    "migrate:checklist": "npm run migrate:checklist --prefix backend",
    "build:web": "npm run build --prefix frontend",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
