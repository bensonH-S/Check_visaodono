{
  "name": "vision-check",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npx --yes kill-port 5000 5173 5174 5175",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --watch server.js",
    "dev:web": "npx --yes wait-on tcp:127.0.0.1:5000 -t 45000 && npm run dev --prefix frontend",
    "migrate": "npm run migrate --prefix backend",
    "migrate:lojas": "npm run migrate:lojas --prefix backend",
    "migrate:checklist": "npm run migrate:checklist --prefix backend",
    "migrate:manutencao": "npm run migrate:manutencao --prefix backend",
    "migrate:auth": "npm run migrate:auth --prefix backend",
    "seed:auth": "node backend/scripts/seed-auth.js",
    "migrate:ti": "npm run migrate:ti --prefix backend",
    "migrate:usuario-lojas": "npm run migrate:usuario-lojas --prefix backend",
    "migrate:permissoes": "npm run migrate:permissoes --prefix backend",
    "migrate:sla": "npm run migrate:sla --prefix backend",
    "migrate:sla-urgencia": "npm run migrate:sla-urgencia --prefix backend",
    "migrate:config-perm": "npm run migrate:config-perm --prefix backend",
    "migrate:media": "npm run migrate:media --prefix backend",
    "migrate:atualizacoes": "npm run migrate:atualizacoes --prefix backend",
    "migrate:notificacoes": "npm run migrate:notificacoes --prefix backend",
    "migrate:notif-eventos": "npm run migrate:notif-eventos --prefix backend",
    "migrate:chamado-eventos": "npm run migrate:chamado-eventos --prefix backend",
    "migrate:kanban-aprovacao": "npm run migrate:kanban-aprovacao --prefix backend",
    "migrate:aprovar": "npm run migrate:aprovar --prefix backend",
    "migrate:cargo-aprovacao": "npm run migrate:cargo-aprovacao --prefix backend",
    "migrate:cargos": "npm run migrate:cargos --prefix backend",
    "migrate:cargos-perfis": "npm run migrate:cargos-perfis --prefix backend",
    "build": "npm run build:web",
    "prebuild:web": "node scripts/write-version.js",
    "build:web": "npm run build --prefix frontend",
    "start": "node server.js --production",
    "start:prod": "npm run build:web && npm run start",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
