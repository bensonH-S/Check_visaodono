# PostgreSQL
# Local (npm run dev): o server força vision_check_dev.
# Produção (node server.js --production): use vision_check, ou omita DB_NAME (default: vision_check).
# DB_HOST=
# DB_USER=
# DB_PASS=
# DB_NAME=vision_check_dev
# DB_PORT=5432
# DB_SSL=false

# SMTP — mesmo padrão do FreeControl (nodemailer)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=seu-email@grupoalvim.com.br
# SMTP_PASS=senha-de-app
# SMTP_SERVICE=gmail
# MAIL_FROM="Vision Check — Grupo Alvim" <seu-email@grupoalvim.com.br>

# Envio automático do relatório PDF ao finalizar checklist (default: true)
# VISITA_RELATORIO_EMAIL_ENABLED=true

# Fulltrack — rastreamento de frota (backend/.env ou env do Docker; reinicie a API após alterar)
# Preferencial:
# FULLTRACK_RASTREAMENTO_ENABLED=true
# FULLTRACK_API_KEY=
# FULLTRACK_SECRET_KEY=
# FULLTRACK_API_URL=http://ws.fulltrack2.com
# FULLTRACK_LIMITE_VELOCIDADE_KMH=80
# Compatível com o formato antigo (também funciona):
# APIKEY=
# SECRETKEY=
# API_URL=http://ws.fulltrack2.com
