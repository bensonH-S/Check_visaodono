# Cópia para visao/.env (não versionado)

# --- Stream ---
# Preferencial: URL RTSP direta (IP local na loja / VPN / túnel)
# Descubra com: python -m scripts.probe_loja --ip SEU_IP --save-env
# Exemplos Dahua/Intelbras:
#   rtsp://USER:PASS@IP:554/cam/realmonitor?channel=1&subtype=0
#   rtsp://USER:PASS@IP:554/Streaming/Channels/101
VISAO_RTSP_URL=

# IP local (opcional — usado só como lembrete; o probe pede --ip)
VISAO_CAMERA_IP=

# Fallback Cloud/P2P (Dahua/Intelbras) — referência; OpenCV não abre serial sozinho.
VISAO_CAMERA_NAME=Bk 408 Sul
VISAO_CAMERA_SERIAL=
VISAO_CAMERA_PORT=37777
VISAO_CAMERA_USER=admin
VISAO_CAMERA_PASS=

# Teste
VISAO_SNAPSHOT_DIR=snapshots
VISAO_TEST_FRAMES=30
